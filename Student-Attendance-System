<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Student Attendance System</title>

<style>
body{
font-family:'Segoe UI',sans-serif;
margin:0;
padding:20px;
min-height:100vh;
background:radial-gradient(circle at top left,rgba(99,102,241,.25),transparent 30%),radial-gradient(circle at bottom right,rgba(6,182,212,.25),transparent 30%),#0f172a;
}

.login-page{
position:fixed;
top:0;
left:0;
width:100%;
height:100vh;
display:flex;
justify-content:center;
align-items:center;
overflow:hidden;
background:linear-gradient(-45deg,#0f172a,#1e293b,#312e81,#0891b2);
background-size:400% 400%;
animation:bgMove 12s ease infinite;
z-index:9999;
}

.login-page::before,.login-page::after{
content:"";
position:absolute;
border-radius:50%;
}

.login-page::before{
width:500px;
height:500px;
background:rgba(255,255,255,.08);
top:-150px;
left:-150px;
animation:float 8s ease-in-out infinite;
}

.login-page::after{
width:400px;
height:400px;
background:rgba(255,255,255,.05);
bottom:-100px;
right:-100px;
animation:float 10s ease-in-out infinite reverse;
}

.login-box{
width:350px;
padding:35px;
text-align:center;
backdrop-filter:blur(15px);
background:rgba(255,255,255,.08);
border:1px solid rgba(255,255,255,.15);
border-radius:25px;
box-shadow:0 8px 32px rgba(0,0,0,.35);
animation:zoomIn 1s ease;
}

.login-box h2{
color:white;
font-size:32px;
}

.login-box p{
color:#dbeafe;
}

.login-box input{
width:100%;
padding:14px;
margin:10px 0;
border:none;
border-radius:12px;
background:rgba(255,255,255,.15);
color:white;
box-sizing:border-box;
}

.login-box input::placeholder{
color:#dbeafe;
}

.login-box button{
width:100%;
padding:14px;
border:none;
border-radius:12px;
color:white;
cursor:pointer;
background:linear-gradient(135deg,#6366f1,#06b6d4);
}

.container{
max-width:1000px;
margin:auto;
background:#fff;
padding:25px;
border-radius:18px;
box-shadow:0 10px 25px rgba(0,0,0,.12);
border-top:6px solid #6366f1;
animation:fadeIn .8s ease;
display:none;
}

h1{
text-align:center;
color:#3730a3;
}

.controls{
display:flex;
align-items:center;
gap:5px;
flex-wrap:wrap;
}

input{
padding:11px;
margin:5px;
border:2px solid #dbeafe;
border-radius:10px;
outline:none;
}

input:focus{
border-color:#6366f1;
}

button{
padding:10px 16px;
border:none;
border-radius:10px;
cursor:pointer;
color:white;
background:linear-gradient(135deg,#6366f1,#06b6d4);
}

button:hover{
opacity:.9;
}

.present-btn{
background:#16a34a;
}

.absent-btn{
background:#dc2626;
}

.delete-btn{
background:#64748b;
}

.all-btn{
background:#4338ca;
}

.date-title{
margin-top:15px;
padding:12px;
border-radius:12px;
background:linear-gradient(135deg,#eef2ff,#ecfeff);
color:#3730a3;
font-weight:bold;
text-align:center;
}

.student-summary{
margin-top:15px;
padding:15px;
border-radius:12px;
background:linear-gradient(135deg,#eef2ff,#ecfeff);
color:#3730a3;
font-weight:bold;
text-align:center;
}

.summary{
margin-top:20px;
display:flex;
justify-content:space-around;
padding:15px;
border-radius:12px;
background:linear-gradient(135deg,#eef2ff,#ecfeff);
}

table{
width:100%;
border-collapse:collapse;
margin-top:20px;
}

th{
background:linear-gradient(135deg,#4338ca,#06b6d4);
color:white;
padding:12px;
}

td{
padding:11px;
border-bottom:1px solid #e5e7eb;
text-align:center;
}

.no-record{
text-align:center;
padding:20px;
color:#64748b;
}

@keyframes bgMove{
0%{background-position:0% 50%}
50%{background-position:100% 50%}
100%{background-position:0% 50%}
}

@keyframes zoomIn{
from{opacity:0;transform:scale(.7)}
to{opacity:1;transform:scale(1)}
}

@keyframes float{
0%,100%{transform:translateY(0)}
50%{transform:translateY(30px)}
}

@keyframes fadeIn{
from{opacity:0;transform:translateY(20px)}
to{opacity:1;transform:translateY(0)}
}
</style>
</head>

<body>

<div class="login-page" id="loginPage">
<div class="login-box">
<h2>Welcome Back</h2>
<p>Student Attendance System</p>

<input type="text" id="username" placeholder="Username">
<input type="password" id="password" placeholder="Password">

<button onclick="login()">Login</button>
</div>
</div>

<div class="container">

<h1>Student Attendance Monitoring System</h1>

<div class="controls">

<input type="date" id="attendanceDate" onchange="changeDate()">

<input type="text" id="studentName" placeholder="Enter Student Name">

<button onclick="addStudent()">Add Student</button>

<button class="present-btn" onclick="markAttendance('Present')">
Present
</button>

<button class="absent-btn" onclick="markAttendance('Absent')">
Absent
</button>

<button class="all-btn" onclick="showAllRecords()">
All Records
</button>

</div>

<br>

<input type="text"
id="searchInput"
placeholder="Search Student..."
onkeyup="searchStudent()">

<div id="studentSummary" class="student-summary"></div>

<div class="date-title" id="dateTitle"></div>

<table id="studentTable">

<tr>
<th>Name</th>
<th>Date</th>
<th>Status</th>
<th>Delete</th>
</tr>

</table>

<div class="summary">

<div>
Present:
<span id="presentCount">0</span>
</div>

<div>
Absent:
<span id="absentCount">0</span>
</div>

<div>
Not Marked:
<span id="notMarkedCount">0</span>
</div>

</div>

</div>

<script>

let students=JSON.parse(localStorage.getItem("students"))||[];
let selectedDate="";
let showingAll=false;

function login(){

let user=document.getElementById("username").value;
let pass=document.getElementById("password").value;

if(user==="Bhinge07"&&pass==="Bhinge07"){

document.getElementById("loginPage").style.opacity="0";

setTimeout(function(){

document.getElementById("loginPage").style.display="none";

document.querySelector(".container").style.display="block";

setToday();

},800);

}else{

alert("Invalid Username or Password");

}

}

function saveData(){

localStorage.setItem("students",JSON.stringify(students));

}

function setToday(){

let today=new Date().toISOString().split("T")[0];

selectedDate=today;

document.getElementById("attendanceDate").value=today;

showingAll=false;

loadStudents();

}

function addStudent(){

let name=document.getElementById("studentName").value.trim();
let date=document.getElementById("attendanceDate").value;

if(name===""){

alert("Enter Student Name");
return;

}

if(date===""){

alert("Select Attendance Date");
return;

}

let exists=students.find(function(student){

return student.name.toLowerCase()===name.toLowerCase()
&&student.date===date;

});

if(exists){

alert("This student is already added for this date");
return;

}

students.push({

name:name,
date:date,
status:"Not Marked"

});

saveData();

selectedDate=date;
showingAll=false;

document.getElementById("studentName").value="";

loadStudents();

}

function markAttendance(status){

let name=document.getElementById("studentName").value.trim();
let date=document.getElementById("attendanceDate").value;

if(name===""){

alert("Enter Student Name");
return;

}

if(date===""){

alert("Select Attendance Date");
return;

}

let student=students.find(function(s){

return s.name.toLowerCase()===name.toLowerCase()
&&s.date===date;

});

if(student){

student.status=status;

}else{

students.push({

name:name,
date:date,
status:status

});

}

saveData();

selectedDate=date;
showingAll=false;

document.getElementById("studentName").value="";

loadStudents();

}

function changeDate(){

let date=document.getElementById("attendanceDate").value;

if(date==="")return;

selectedDate=date;
showingAll=false;

document.getElementById("searchInput").value="";

document.getElementById("studentSummary").innerHTML="";

loadStudents();

}

function loadStudents(){

let table=document.getElementById("studentTable");

table.innerHTML=
'<tr><th>Name</th><th>Date</th><th>Status</th><th>Delete</th></tr>';

let records;

if(showingAll){

records=students;

}else{

records=students.filter(function(student){

return student.date===selectedDate;

});

}

let present=0;
let absent=0;
let notMarked=0;

if(records.length===0){

let row=table.insertRow();

let cell=row.insertCell(0);

cell.colSpan=4;

cell.className="no-record";

if(showingAll){

cell.innerText="No attendance records found";

}else{

cell.innerText=
"No attendance record for "+formatDate(selectedDate);

}

}else{

records.forEach(function(student){

let index=students.indexOf(student);

let row=table.insertRow();

row.insertCell(0).innerText=student.name;

row.insertCell(1).innerText=formatDate(student.date);

row.insertCell(2).innerText=student.status;

row.insertCell(3).innerHTML=
'<button class="delete-btn" onclick="deleteStudent('+index+')">Delete</button>';

if(student.status==="Present"){

present++;

}

if(student.status==="Absent"){

absent++;

}

if(student.status==="Not Marked"){

notMarked++;

}

});

}

document.getElementById("presentCount").innerText=present;

document.getElementById("absentCount").innerText=absent;

document.getElementById("notMarkedCount").innerText=notMarked;

if(showingAll){

document.getElementById("dateTitle").innerText=
"All Attendance Records";

}else{

document.getElementById("dateTitle").innerText=
"Attendance for: "+formatDate(selectedDate);

}

searchStudent();

}

function searchStudent(){

let search=document
.getElementById("searchInput")
.value
.toLowerCase()
.trim();

let rows=document.querySelectorAll("#studentTable tr");

let present=0;
let absent=0;
let total=0;

rows.forEach(function(row,index){

if(index===0)return;

if(!row.cells[0])return;

let name=row.cells[0]
.innerText
.toLowerCase();

if(name.includes(search)){

row.style.display="";

if(search!==""){

total++;

if(row.cells[2].innerText==="Present"){

present++;

}

if(row.cells[2].innerText==="Absent"){

absent++;

}

}

}else{

row.style.display="none";

}

});

let summary=document.getElementById("studentSummary");

if(search===""){

summary.innerHTML="";

}else{

summary.innerHTML=
"Present: "+present+
" &nbsp; | &nbsp; Absent: "+absent+
" &nbsp; | &nbsp; Total: "+total;

}

}

function showAllRecords(){

showingAll=true;

document.getElementById("searchInput").value="";

document.getElementById("studentSummary").innerHTML="";

loadStudents();

}

function deleteStudent(index){

let confirmDelete=
confirm("Are you sure you want to delete this attendance record?");

if(confirmDelete){

students.splice(index,1);

saveData();

loadStudents();

}

}

function formatDate(date){

if(!date)return"";

let parts=date.split("-");

return parts[2]+"-"+parts[1]+"-"+parts[0];

}

window.onload=function(){

let today=new Date().toISOString().split("T")[0];

document.getElementById("attendanceDate").value=today;

selectedDate=today;

loadStudents();

};

</script>

</body>
</html>
